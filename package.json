{
  "name": "@pagestudiocms/bootstrap-custom",
  "version": "3.4.1-beta.3",
  "description": "Custom Bootstrap theme with SCSS customizations and utilities",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "scss/bootstrap-custom.scss",
  "style": "scss/bootstrap-custom.scss",
  "sass": "scss/bootstrap-custom.scss",
  "files": [
    "scss/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bootstrap",
    "bootstrap3",
    "scss",
    "css",
    "framework",
    "theme",
    "custom"
  ],
  "dependencies": {},
  "devDependencies": {
    "@pagestudiocms/pagestudio-template-development-server": "^1.0.5",
    "html-includes": "4.4.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.0"
  },
  "scripts": {
    "sass:build": "sass --style compressed scss/bootstrap-custom.scss build/assets/css/bootstrap-custom.css --source-map",
    "sass:watch": "sass --watch scss/bootstrap-custom.scss:build/assets/css/bootstrap-custom.css --source-map",
    "start": "npm-run-all --parallel sass:watch html-compile start-server",
    "start-server": "node ./node_modules/@pagestudiocms/pagestudio-template-development-server/server.js",
    "html-compile": "html-includes --src site/html --dest demo --watch",
    "build": "npm run sass:build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagestudiocms/bootstrap-custom.git"
  },
  "author": "Cosmo Mathieu",
  "license": "MIT",
  "homepage": "https://github.com/pagestudiocms/bootstrap-custom#readme",
  "exports": {
    ".": "./scss/bootstrap-custom.scss",
    "./variables": "./scss/variables-only.scss",
    "./*": "./*"
  }
}
